{
  "FS25 IC Click Point - Full": {
    "scope": "xml",
    "prefix": "mgs-clickpoint",
    "description": "Insert Interactive Control clickPoint with documented attributes",
    "body": [
      "<clickPoint node=\"${1:node}\" iconType=\"${2:CROSS}\" size=\"${3:0.04}\" type=\"${4:UNKNOWN}\" alignToCamera=\"${5:true}\" animMaxLimit=\"${6:1}\" animMinLimit=\"${7:0}\" animName=\"${8:}\" blinkSpeedScale=\"${9:1}\" foldMaxLimit=\"${10:1}\" foldMinLimit=\"${11:0}\" forcedStateValue=\"${12:0}\" direction=\"${13:1}\" invertX=\"${14:false}\" invertZ=\"${15:false}\" scaleOffset=\"${16:0}\" linkNode=\"${17:}\" rotation=\"${18:0 0 0}\" translation=\"${19:0 0 0}\"/>"
    ]
  },
  "FS25 IC Control - Full": {
    "scope": "xml",
    "prefix": "mgs-ic-control",
    "description": "Insert an Interactive Control block with click point and animation",
    "body": [
      "<interactiveControl negText=\"${1:\u0024l10n_actionIC_deactivate}\" posText=\"${2:\u0024l10n_actionIC_activate}\" analog=\"false\" analogSpeed=\"0.04\" allowsSaving=\"true\" enabled=\"true\">",
      "\t<clickPoint node=\"${3:node}\" iconType=\"${4:CROSS}\" size=\"0.04\" type=\"UNKNOWN\" alignToCamera=\"true\"/>",
      "\t<animation name=\"${5:animationName}\" initTime=\"0\" speedScale=\"1\"/>",
      "</interactiveControl>"
    ]
  }
}
