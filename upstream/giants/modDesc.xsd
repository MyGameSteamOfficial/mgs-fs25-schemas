<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:simpleType name="g_vector_float">
        <xs:list itemType="xs:float"/>
    </xs:simpleType>

    <xs:simpleType name="g_string">
        <xs:annotation><xs:appinfo><typeStr>String</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_string_list">
        <xs:annotation><xs:appinfo><typeStr>One or more strings separated by a single whitespace</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\S+( \S+)*"/>
            <xs:whiteSpace value="preserve"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_l10n_string">
        <xs:annotation><xs:appinfo><typeStr>String or l10n key</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_filename">
        <xs:annotation><xs:appinfo><typeStr>Path to a certain file</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_float">
        <xs:annotation><xs:appinfo><typeStr>Float</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:float"/>
    </xs:simpleType>

    <xs:simpleType name="g_angle">
        <xs:annotation><xs:appinfo><typeStr>Angle</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:float"/>
    </xs:simpleType>

    <xs:simpleType name="g_time">
        <xs:annotation><xs:appinfo><typeStr>Time in seconds</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:float"/>
    </xs:simpleType>

    <xs:simpleType name="g_day_time">
        <xs:annotation><xs:appinfo><typeStr>Time hh:mm:ss.sss format</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:time"/>
    </xs:simpleType>

    <xs:simpleType name="g_int">
        <xs:annotation><xs:appinfo><typeStr>Integer</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:integer"/>
    </xs:simpleType>

    <xs:simpleType name="g_uint">
        <xs:annotation><xs:appinfo><typeStr>Integer (unsigned)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:integer"/>
    </xs:simpleType>

    <xs:simpleType name="g_bool">
        <xs:annotation><xs:appinfo><typeStr>Boolean</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="true|false"/>
            <xs:whiteSpace value="preserve"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_node_index">
        <xs:annotation><xs:appinfo><typeStr>Index to i3d node or i3d mapping identifier</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_node_indices">
        <xs:annotation><xs:appinfo><typeStr>List of indices to i3d nodes or i3d mapping identifiers</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_vector_2">
        <xs:annotation><xs:appinfo><typeStr>Multiple values (x, y)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_3">
        <xs:annotation><xs:appinfo><typeStr>Multiple values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_4">
        <xs:annotation><xs:appinfo><typeStr>Multiple values (x, y, z, w)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_n">
        <xs:annotation><xs:appinfo><typeStr>Multiple values</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float"/>
    </xs:simpleType>

    <xs:simpleType name="g_vector_trans">
        <xs:annotation><xs:appinfo><typeStr>Translation values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_rot">
        <xs:annotation><xs:appinfo><typeStr>Rotation values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_rot_2">
        <xs:annotation><xs:appinfo><typeStr>Rotation values (x, y)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_scale">
        <xs:annotation><xs:appinfo><typeStr>Scale values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_color">
        <xs:annotation><xs:appinfo><typeStr>Color values (r, g, b) or brand color id</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_vehicle_material">
        <xs:annotation><xs:appinfo><typeStr>Name of brand material template or color values (r,g,b)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:element name="modDesc">
        <xs:complexType>
            <xs:all>
                <xs:element name="actions" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="action" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="axisType" type="g_string">
                                    </xs:attribute>
                                    <xs:attribute name="category" type="g_string">
                                    </xs:attribute>
                                    <xs:attribute name="displayCategory" type="g_string">
                                    </xs:attribute>
                                    <xs:attribute name="ignoreComboMask" type="g_bool">
                                    </xs:attribute>
                                    <xs:attribute name="name" type="g_string">
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="author" type="g_string" minOccurs="1">
                    <xs:annotation><xs:documentation xml:lang="en">Author(s) of the mod</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="bales" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="bale" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="filename" type="g_filename">
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="brands" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="brand" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="image" type="g_filename">
                                    </xs:attribute>
                                    <xs:attribute name="imageOffset" type="g_float">
                                    </xs:attribute>
                                    <xs:attribute name="name" type="g_string">
                                    </xs:attribute>
                                    <xs:attribute name="title" type="g_string">
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="connectionHoses" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="connectionHose" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="xmlFilename" type="g_filename">
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="consumables" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="consumable" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="xmlFilename" type="g_filename">
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="densityMapHeightTypes" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:attribute name="filename" type="g_filename">
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="dependencies" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="dependency" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">filename of the mod (without &apos;.zip&apos;) to be installed for this mod to be used</xs:documentation></xs:annotation>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="description" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="br" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="cs" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="ct" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="cz" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="da" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="de" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="ea" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="en" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="es" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="fc" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="fi" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="fr" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="hu" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="id" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="it" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="jp" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="kr" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="nl" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="no" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="pl" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="pt" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="ro" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="ru" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="sv" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="tr" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="uk" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="vi" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">localized description</xs:documentation></xs:annotation>
                            </xs:element>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
                <xs:element name="extraSourceFiles" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="sourceFile" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="filename" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">additional lua file to source</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="fillTypes" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:attribute name="filename" type="g_filename">
                            <xs:annotation><xs:documentation xml:lang="en">file path to additional fillTypes xml file</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="handToolSpecializations" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="specialization" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="className" type="g_string" use="required">
                                        <xs:annotation><xs:documentation xml:lang="en">The name of the specialization class</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="filename" type="g_string" use="required">
                                        <xs:annotation><xs:documentation xml:lang="en">The path of the specialization file</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="name" type="g_string" use="required">
                                        <xs:annotation><xs:documentation xml:lang="en">The name of the specialization</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="handToolTypes" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="type" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="specialization" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="name" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">The name of the specialization to be part of this type</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="className" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">The name of the class to use</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="filename" type="g_string" use="required">
                                        <xs:annotation><xs:documentation xml:lang="en">The path of the types lua script file</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="name" type="g_string" use="required">
                                        <xs:annotation><xs:documentation xml:lang="en">The name of the type</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="parent" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">The name of the parent type to inherit from</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="helpLines" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="category" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="page" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:choice maxOccurs="unbounded">
                                                    <xs:element name="paragraph" minOccurs="0" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:all>
                                                                <xs:element name="image" minOccurs="0" maxOccurs="1">
                                                                    <xs:complexType>
                                                                        <xs:attribute name="aspectRatio" type="g_float" default="1">
                                                                        </xs:attribute>
                                                                        <xs:attribute name="displaySize" type="g_string">
                                                                        </xs:attribute>
                                                                        <xs:attribute name="filename" type="g_filename">
                                                                            <xs:annotation><xs:documentation xml:lang="en">paragraph image filepath</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                        <xs:attribute name="heightScale" type="g_float" default="1">
                                                                        </xs:attribute>
                                                                        <xs:attribute name="size" type="g_vector_2" default="1024 1024">
                                                                            <xs:annotation><xs:documentation xml:lang="en">image size</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                        <xs:attribute name="uvs" type="g_string_list">
                                                                            <xs:annotation><xs:documentation xml:lang="en">image uvs</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                    </xs:complexType>
                                                                </xs:element>
                                                                <xs:element name="text" minOccurs="0" maxOccurs="1">
                                                                    <xs:complexType>
                                                                        <xs:attribute name="alignToImage" type="g_bool">
                                                                        </xs:attribute>
                                                                        <xs:attribute name="text" type="g_l10n_string">
                                                                            <xs:annotation><xs:documentation xml:lang="en">paragraph text l10n key</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                    </xs:complexType>
                                                                </xs:element>
                                                                <xs:element name="title" minOccurs="0" maxOccurs="1">
                                                                    <xs:complexType>
                                                                        <xs:attribute name="text" type="g_l10n_string">
                                                                            <xs:annotation><xs:documentation xml:lang="en">paragraph title l10n key</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                    </xs:complexType>
                                                                </xs:element>
                                                            </xs:all>
                                                            <xs:attribute name="noSpacing" type="g_bool">
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:choice>
                                                <xs:attribute name="iconFilename" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">page icon filepath</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="iconSliceId" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">page icon slice id</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="id" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">page title l10n key</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="title" type="g_l10n_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">page title l10n key</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="title" type="g_l10n_string">
                                        <xs:annotation><xs:documentation xml:lang="en">category title l10n key</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="iconFilename" type="g_filename" minOccurs="1">
                    <xs:annotation><xs:documentation xml:lang="en">Path to the icon used for the whole mod</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="inputBinding" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="actionBinding" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="binding" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="axisComponent" type="g_string">
                                                </xs:attribute>
                                                <xs:attribute name="device" type="g_string">
                                                </xs:attribute>
                                                <xs:attribute name="index" type="g_int">
                                                </xs:attribute>
                                                <xs:attribute name="input" type="g_string">
                                                </xs:attribute>
                                                <xs:attribute name="inputComponent" type="g_string">
                                                </xs:attribute>
                                                <xs:attribute name="neutralInput" type="g_int">
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="action" type="g_string">
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="isSelectable" type="g_bool" minOccurs="0">
                    <xs:annotation><xs:documentation xml:lang="en">If the mod is selectable in the mod selection screen</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="jointTypes" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="jointType" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="name" type="g_filename">
